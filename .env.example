# SQLite file (default: .data/nekogaku.sqlite). A libsql:// URL works too, with DATABASE_AUTH_TOKEN.
DATABASE_URL=
DATABASE_AUTH_TOKEN=
# Set to false only when serving production over plain http (no TLS) for a quick test.
COOKIE_SECURE=
# Only used by npm run voice:build.
VOICEVOX_URL=http://127.0.0.1:50021
