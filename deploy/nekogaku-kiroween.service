# systemd unit for a VPS. Copy to /etc/systemd/system/, adjust User and WorkingDirectory, then:
#   sudo systemctl daemon-reload && sudo systemctl enable --now nekogaku-kiroween
[Unit]
Description=NekoGaku Kiroween (Next.js)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/home/ubuntu/nekogaku-kiroween
Environment=NODE_ENV=production
Environment=PORT=3100
ExecStart=/usr/bin/env npx next start -H 127.0.0.1 -p 3100
Restart=on-failure

[Install]
WantedBy=multi-user.target
